*.json
.DS_Store

# Local production DB dumps for testing — contain user data, never commit
catalogbeer-*.sql
.editorconfig
.nova/
# Secrets -- the repo-root common/ mirrors the vhost-root secrets dir on the
# 26.04 servers (outside public_html/). Ignore the file, not the directory:
# common/Secrets.md (rotation checklist) stays tracked.
common/passwords.php
# Defensive: the secrets file must never reappear inside the web root either.
public_html/common/passwords.php

# Tests: track collection and example env, ignore real env files
!tests/Catalog.beer.postman_collection.json
!tests/env.example.json
# Captured Google Address Validation responses — the address-parse.php fixtures
!tests/fixtures/google-address-validation.json
tests/staging.env.json
tests/production.env.json

# Scratch space: local working files (dumps, exports, one-off scripts, notes).
# Contents are ignored by git AND excluded from rsync in deploy.sh, so nothing
# here can reach a server. Keep the directory itself tracked via .gitkeep so a
# fresh clone has somewhere obvious to put this stuff.
scratch/*
!scratch/.gitkeep

# Deploy targets (server addresses + SSH user). See deploy.conf.example.
deploy.conf
